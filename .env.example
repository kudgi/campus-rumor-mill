# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campus_rumor_mill
# HTTP port
PORT=3000
# Public web origin for CORS
CORS_ORIGIN=http://localhost:3000
# Secret used to salt fingerprint hashes
SESSION_SECRET=replace-with-at-least-32-random-characters
# Internal API key for administrative debunking
ADMIN_API_KEY=replace-with-a-long-admin-key
# Flags required to auto-debunk a rumor
FLAG_THRESHOLD=5
# Exponential decay lambda per hour
DECAY_LAMBDA=0.05
# Credibility points per upvote
UPVOTE_WEIGHT=5
# Initial credibility score
INITIAL_CREDIBILITY=50
# Cookie security toggle
COOKIE_SECURE=false
# Number of trusted reverse proxies
TRUST_PROXY=0
# Maximum new sessions per fingerprint window
SESSION_FINGERPRINT_LIMIT=5
# Fingerprint throttling window in seconds
SESSION_FINGERPRINT_WINDOW_SECONDS=3600
